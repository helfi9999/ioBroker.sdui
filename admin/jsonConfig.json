{
  "i18n": true,
  "type": "panel",
  "items": {
    "intro": {
      "type": "staticText",
      "text": "Unofficial SDUI integration for school timetables and news. Account credentials are stored in protected adapter settings.",
      "newLine": true,
      "sm": 12,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 4
    },
    "identifier": {
      "type": "text",
      "label": "Sdui username or email (identifier)",
      "newLine": true,
      "sm": 12,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 4
    },
    "password": {
      "type": "password",
      "label": "Sdui password",
      "newLine": true,
      "sm": 12,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 4
    },
    "schoolSearch": {
      "type": "text",
      "label": "Search school (name or postal code)",
      "newLine": true,
      "sm": 12,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 4
    },
    "slink": {
      "type": "selectSendTo",
      "label": "Select school",
      "command": "searchSchools",
      "jsonData": "{\"search\":\"${data.schoolSearch}\"}",
      "alsoDependsOn": [
        "schoolSearch"
      ],
      "manual": true,
      "newLine": true,
      "sm": 12,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 4
    },
    "userId": {
      "type": "selectSendTo",
      "label": "Select timetable user",
      "command": "listTimetableUsers",
      "manual": true,
      "newLine": true,
      "sm": 12,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 4
    },
    "intervalMinutes": {
      "type": "number",
      "label": "Update interval in minutes (min. 15)",
      "min": 15,
      "max": 1440,
      "newLine": true,
      "sm": 12,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 4
    },
    "daysPast": {
      "type": "number",
      "label": "Days past (0–21); at least 14 for previous weeks",
      "min": 0,
      "max": 21,
      "newLine": true,
      "sm": 12,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 4
    },
    "daysFuture": {
      "type": "number",
      "label": "Days future (1–210); beyond 35 days refreshed daily",
      "min": 1,
      "max": 210,
      "newLine": true,
      "sm": 12,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 4
    }
  }
}
